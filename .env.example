# Скопируйте в .env и поправьте под свой сервер:  cp .env.example .env

# Домен сайта. В DNS у домена должна быть A-запись на IP вашего VDS.
# Без домена: DOMAIN=:80 и SECURE_COOKIES=0 (сайт по http://IP, без шифрования — только для проверки).
DOMAIN=files.example.ru

# 1 — cookie только по HTTPS (обязательно, когда указан домен)
SECURE_COOKIES=1

# Предельный размер одного загружаемого файла, ГБ
MAX_UPLOAD_GB=10

# Порты снаружи (менять не нужно, если на сервере больше ничего нет)
HTTP_PORT=80
HTTPS_PORT=443
